    "RgN-pS-F7Y.text" : {
      "comment" : "Class = \"UILabel\"; text = \"If you have even tried to quit once in the past, you have some idea how it feels, the challenges you experienced, and what caused you to start smoking again. That means you’ve already tasted this journey and know how tricky it can be. There are small steps you can take now to help you quit for good and increase your chances of success. Learn the skills that will help you permanently achieve a tobacco-free life.\\n\\nIn the following sections, you can learn about recommended strategies for overcoming potential challenges you may encounter!\"; ObjectID = \"RgN-pS-F7Y\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If you have even tried to quit once in the past, you have some idea how it feels, the challenges you experienced, and what caused you to start smoking again. That means you’ve already tasted this journey and know how tricky it can be. There are small steps you can take now to help you quit for good and increase your chances of success. Learn the skills that will help you permanently achieve a tobacco-free life.\n\nIn the following sections, you can learn about recommended strategies for overcoming potential challenges you may encounter!"
          }
        }
      }
    },
    "RrI-kC-KYs.text" : {
      "comment" : "Class = \"UILabel\"; text = \"Keep up the great work—you're laying the groundwork for a healthier, happier life!\"; ObjectID = \"RrI-kC-KYs\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Keep up the great work—you're laying the groundwork for a healthier, happier life!"
          }
        }
      }
    },
    "rtI-UP-JY5.text" : {
      "comment" : "Class = \"UILabel\"; text = \"Alcohol-related mental dysfunction\"; ObjectID = \"rtI-UP-JY5\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Alcohol-related mental dysfunction"
          }
        }
      }
    },
    "RxC-P7-fa6.text" : {
      "comment" : "Class = \"UILabel\"; text = \"These individuals tend to drink more, socialize with people who drink a lot, and develop a tolerance to alcohol (i.e., it takes more and more alcohol to feel or act intoxicated). As a result, they have an increased risk for developing AUD. Someone who misuses alcohol, especially over the long-term, can experience permanent liver, heart, or brain damage. And all people who drink, regardless of the amount, need to be aware that critical decision-making abilities and driving- related skills are already diminished long before a person shows physical signs of intoxication.\\n\"; ObjectID = \"RxC-P7-fa6\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "These individuals tend to drink more, socialize with people who drink a lot, and develop a tolerance to alcohol (i.e., it takes more and more alcohol to feel or act intoxicated). As a result, they have an increased risk for developing AUD. Someone who misuses alcohol, especially over the long-term, can experience permanent liver, heart, or brain damage. And all people who drink, regardless of the amount, need to be aware that critical decision-making abilities and driving- related skills are already diminished long before a person shows physical signs of intoxication.\n"
          }
        }
      }
    },
    "S7V-PM-qM3.text" : {
      "comment" : "Class = \"UILabel\"; text = \"Women\"; ObjectID = \"S7V-PM-qM3\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Women"
          }
        }
      }
    },
    "Sep-Lf-yeg.text" : {
      "comment" : "Class = \"UILabel\"; text = \"Schedule the date when you will quit. Make it soon, preferably within a month, so you will still be excited to become tobacco-free. Cut back on your tobacco use by one cigarette every two days before you completely give up tobacco on your quit date. Aim to start quitting completely when you are down to at least 10 cigarettes per day.\"; ObjectID = \"Sep-Lf-yeg\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Schedule the date when you will quit. Make it soon, preferably within a month, so you will still be excited to become tobacco-free. Cut back on your tobacco use by one cigarette every two days before you completely give up tobacco on your quit date. Aim to start quitting completely when you are down to at least 10 cigarettes per day."
          }
        }
      }
    },
    "Sg1-gQ-aN3.text" : {
      "comment" : "Class = \"UILabel\"; text = \"Most teens who smoke think they will quit in their 20s and actually don't until their 40s. Stopping smoking is about making a change and that is something we're not too good at, in fact smoking cessation can be a long journey of trying and relapsing, just like a long ride on a roller coaster. There is no magic solution or medication to transform one to a non-smoker overnight, though some people have the gene to be able to quit smoking or drinking without any struggles.\\n\\n\\nSo what does this ride of change look like? There are 4 steps and helpful strategies you can take!\"; ObjectID = \"Sg1-gQ-aN3\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Most teens who smoke think they will quit in their 20s and actually don't until their 40s. Stopping smoking is about making a change and that is something we're not too good at, in fact smoking cessation can be a long journey of trying and relapsing, just like a long ride on a roller coaster. There is no magic solution or medication to transform one to a non-smoker overnight, though some people have the gene to be able to quit smoking or drinking without any struggles.\n\n\nSo what does this ride of change look like? There are 4 steps and helpful strategies you can take!"
          }
        }
      }
    },
    "sjN-BT-7Kd.text" : {
      "comment" : "Class = \"UILabel\"; text = \"Reduced cognitive function; negatively affects one’s attention, concentration, and processing speed, makes and perform tasks that require mental clarity and concentration.\"; ObjectID = \"sjN-BT-7Kd\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Reduced cognitive function; negatively affects one’s attention, concentration, and processing speed, makes and perform tasks that require mental clarity and concentration."
          }
        }
      }
    },
