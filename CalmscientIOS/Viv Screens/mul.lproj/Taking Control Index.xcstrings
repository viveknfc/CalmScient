    "WTS-sK-lmi.text" : {
      "comment" : "Class = \"UILabel\"; text = \"No TV, phones, or gadgets in bed. Make your bedroom quiet, dark, relaxing, and comfy.\\nSkip heavy meals or alcohol right before bedtime.\"; ObjectID = \"WTS-sK-lmi\";",
