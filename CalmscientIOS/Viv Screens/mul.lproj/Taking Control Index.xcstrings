    "aYo-Tt-lxa.text" : {
      "comment" : "Class = \"UILabel\"; text = \"Memory problem; alcohol can impair both short-term and long-term memory. I can lead to blackouts(Can’t recall events that occurred while one is intoxicated).\"; ObjectID = \"aYo-Tt-lxa\";",
