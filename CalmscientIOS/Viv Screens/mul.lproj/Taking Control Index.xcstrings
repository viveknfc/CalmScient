    "6pQ-zO-rJm.text" : {
      "comment" : "Class = \"UILabel\"; text = \"Do things you enjoy, even if they're small. Those little things can make you feel better.\"; ObjectID = \"6pQ-zO-rJm\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Do things you enjoy, even if they're small. Those little things can make you feel better."
          }
        }
      }
    },
    "6sN-zr-MXh.text" : {
      "comment" : "Class = \"UILabel\"; text = \"There is a wide range of short- and long-term consequences associated with alcohol misuse. For some individuals, any amount of drinking could be potentially harmful\"; ObjectID = \"6sN-zr-MXh\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "There is a wide range of short- and long-term consequences associated with alcohol misuse. For some individuals, any amount of drinking could be potentially harmful"
          }
        }
      }
    },
    "6Zx-9i-0VD.text" : {
      "comment" : "Class = \"UILabel\"; text = \"Up to 4 or more drinks\"; ObjectID = \"6Zx-9i-0VD\";",
      "extractionState" : "extracted_with_value",
