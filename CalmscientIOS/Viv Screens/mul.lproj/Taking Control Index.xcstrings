    "ZLc-bt-u7K.text" : {
      "comment" : "Class = \"UILabel\"; text = \"It’s OK to start nicotine patches, gum, or lozenges a week or two before you quit smoking. This can help you get ready and may cut down on your smoking. Starting medicine, especially the nicotine patch, before you quit may improve your chances of quitting successfully.\"; ObjectID = \"ZLc-bt-u7K\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It’s OK to start nicotine patches, gum, or lozenges a week or two before you quit smoking. This can help you get ready and may cut down on your smoking. Starting medicine, especially the nicotine patch, before you quit may improve your chances of quitting successfully."
          }
        }
      }
    },
    "ZmH-uX-iMq.text" : {
      "comment" : "Class = \"UILabel\"; text = \"You’ve reached your quit date and committed yourself to a tobacco-free life.\\n\\nBe proud! Quit smoking is like a relationship breakup and going through some losses.. You might have to break up your routine a little bit to avoid certain places, friends, and start a new routine to distract yourself. The plan requires you to think about more than just quitting smoking, but changes to your lifestyle.\\n\\nThere are some keys to achieve a permanent tobacco-free life.\\n\\nWhat can you do?\"; ObjectID = \"ZmH-uX-iMq\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You’ve reached your quit date and committed yourself to a tobacco-free life.\n\nBe proud! Quit smoking is like a relationship breakup and going through some losses.. You might have to break up your routine a little bit to avoid certain places, friends, and start a new routine to distract yourself. The plan requires you to think about more than just quitting smoking, but changes to your lifestyle.\n\nThere are some keys to achieve a permanent tobacco-free life.\n\nWhat can you do?"
          }
        }
      }
    },
