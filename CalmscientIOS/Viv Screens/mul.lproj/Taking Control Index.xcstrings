    },
    "Uyh-Li-P94.text" : {
      "comment" : "Class = \"UILabel\"; text = \"I’m proud of you for recognizing the need to control your drinking pattern! Acknowledging your drinking patterns is a crucial first step toward healthier habits.\"; ObjectID = \"Uyh-Li-P94\";",
