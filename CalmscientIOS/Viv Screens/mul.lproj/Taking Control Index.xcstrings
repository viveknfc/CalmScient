    },
    "LnT-YJ-LAa.text" : {
      "comment" : "Class = \"UILabel\"; text = \"Drinking is associated with a number of health problems and can make certain chronic health problems worse. \"; ObjectID = \"LnT-YJ-LAa\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Drinking is associated with a number of health problems and can make certain chronic health problems worse. "
          }
        }
      }
    },
    "LNx-3j-bqd.text" : {
      "comment" : "Class = \"UILabel\"; text = \"People who smoke are more likely to have anxiety or depression than people who don’t smoke. Some people feel mood changes for a short time after they quit smoking. For some people, smoking may seem like it helps with anxiety or depression, but don’t be tricked. Smoking might make you feel better in the short-term, but that’s because the nicotine in cigarettes stops the discomfort of withdrawal, and not because it is helping with anxiety or depression. There are much better ways to deal with withdrawal symptoms and mood changes than returning to smoking! The good news is that once people have been smoke-free for a few months, their anxiety and depression levels are often lower than when they were smoking.\\n\\nHere's how you can manage it:\"; ObjectID = \"LNx-3j-bqd\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "People who smoke are more likely to have anxiety or depression than people who don’t smoke. Some people feel mood changes for a short time after they quit smoking. For some people, smoking may seem like it helps with anxiety or depression, but don’t be tricked. Smoking might make you feel better in the short-term, but that’s because the nicotine in cigarettes stops the discomfort of withdrawal, and not because it is helping with anxiety or depression. There are much better ways to deal with withdrawal symptoms and mood changes than returning to smoking! The good news is that once people have been smoke-free for a few months, their anxiety and depression levels are often lower than when they were smoking.\n\nHere's how you can manage it:"
          }
        }
      }
    },
    "Lrj-VK-ABb.text" : {
      "comment" : "Class = \"UILabel\"; text = \"Nicotine cravings\"; ObjectID = \"Lrj-VK-ABb\";",
