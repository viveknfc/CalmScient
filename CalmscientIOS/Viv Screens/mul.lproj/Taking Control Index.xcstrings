          }
        }
      }
    },
    "LAu-rm-KDv.text" : {
      "comment" : "Class = \"UILabel\"; text = \"It's important to reflect on your drinking habits, especially during social events, and consider how you can enjoy those moments without going overboard. By taking small steps to reduce your consumption, you’ll start to see the benefits for both your health and your relationships.\"; ObjectID = \"LAu-rm-KDv\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It's important to reflect on your drinking habits, especially during social events, and consider how you can enjoy those moments without going overboard. By taking small steps to reduce your consumption, you’ll start to see the benefits for both your health and your relationships."
          }
        }
      }
    },
    "LKz-Js-6no.text" : {
