          }
        }
      }
    },
    "GE4-d8-TZV.text" : {
      "comment" : "Class = \"UILabel\"; text = \"I’m proud of you for recognizing the need to address your heavy drinking! Acknowledging that your drinking patterns may be problematic is a crucial first step toward a healthier life.\"; ObjectID = \"GE4-d8-TZV\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "I’m proud of you for recognizing the need to address your heavy drinking! Acknowledging that your drinking patterns may be problematic is a crucial first step toward a healthier life."
          }
        }
      }
    },
    "gkL-QT-cgz.text" : {
      "comment" : "Class = \"UILabel\"; text = \"Work your strengths\"; ObjectID = \"gkL-QT-cgz\";",
      "extractionState" : "extracted_with_value",
