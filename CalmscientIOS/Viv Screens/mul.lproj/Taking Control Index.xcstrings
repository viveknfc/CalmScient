    "NCM-4s-eAi.text" : {
      "comment" : "Class = \"UILabel\"; text = \"How is vaping (E-cigarettes) safer than tobacco?\"; ObjectID = \"NCM-4s-eAi\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
