    "w7e-B9-Y9Y.text" : {
      "comment" : "Class = \"UILabel\"; text = \"Nicotine does things in your brain that make you feel good and more awake. It releases chemicals like dopamine, norepinephrine, and serotonin, which are responsible for those \\\"feeling good\\\" and \\\"being awake\\\" vibes. Nicotine also gives you a quick boost of endorphins, which can help you relax and ease any pains.\\n\\nThat's why some people, both adults and teens, use smoking to kind of \\\"reset\\\" their mood, emotions, and attention. Especially for those who struggle with anxiety or feeling down, smoking might be a way they try to make themselves feel better. But it's important to know that there are healthier ways to deal with these feelings.\"; ObjectID = \"w7e-B9-Y9Y\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Nicotine does things in your brain that make you feel good and more awake. It releases chemicals like dopamine, norepinephrine, and serotonin, which are responsible for those \"feeling good\" and \"being awake\" vibes. Nicotine also gives you a quick boost of endorphins, which can help you relax and ease any pains.\n\nThat's why some people, both adults and teens, use smoking to kind of \"reset\" their mood, emotions, and attention. Especially for those who struggle with anxiety or feeling down, smoking might be a way they try to make themselves feel better. But it's important to know that there are healthier ways to deal with these feelings."
          }
        }
      }
    },
    "WAU-78-GDx.text" : {
      "comment" : "Class = \"UILabel\"; text = \"Blackouts are gaps in a person’s memory for events that occurred while they were intoxicated. These gaps happen when a person drinks enough alcohol to temporarily block the transfer of memories from short- to long-term storage—known as memory consolidation—in a brain area called the hippocampus.\"; ObjectID = \"WAU-78-GDx\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Blackouts are gaps in a person’s memory for events that occurred while they were intoxicated. These gaps happen when a person drinks enough alcohol to temporarily block the transfer of memories from short- to long-term storage—known as memory consolidation—in a brain area called the hippocampus."
          }
        }
      }
    },
    "WGN-KJ-8FW.text" : {
      "comment" : "Class = \"UILabel\"; text = \"Would you like to know your drink counts?\"; ObjectID = \"WGN-KJ-8FW\";",
