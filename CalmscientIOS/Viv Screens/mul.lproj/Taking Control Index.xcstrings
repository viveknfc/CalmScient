    "uxo-Hg-sa8.text" : {
      "comment" : "Class = \"UILabel\"; text = \"Half of liver disease deaths in the United States are caused by alcohol, and alcohol-associated liver disease is increasing, particularly among women and young people. \"; ObjectID = \"uxo-Hg-sa8\";",
