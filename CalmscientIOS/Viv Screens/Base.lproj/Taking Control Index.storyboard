        <!--Drinking CountVC-->
        <scene sceneID="n0z-Rp-Qda">
            <objects>
                <viewController storyboardIdentifier="DrinkingCountVC" id="JJJ-Sm-qiH" customClass="DrinkingCountVC" customModule="CalmscientIOS" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="fJh-n5-2oO">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Now let’s see what drinking habits do you have" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="9Ti-Yg-mwU" userLabel="topLeftLabel" customClass="FontLL15" customModule="CalmscientIOS" customModuleProvider="target">
                                <rect key="frame" x="20" y="79" width="228" height="40"/>
                                <constraints>
                                    <constraint firstAttribute="height" constant="40" id="aN1-MH-c00"/>
                                </constraints>
                                <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                <nil key="textColor"/>
                                <nil key="highlightedColor"/>
