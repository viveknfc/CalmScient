                                                        <nil key="highlightedColor"/>
                                                    </label>
                                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="A2h-us-13o" customClass="FontLL15" customModule="CalmscientIOS" customModuleProvider="target">
                                                        <rect key="frame" x="40" y="234" width="333" height="160"/>
                                                        <constraints>
                                                            <constraint firstAttribute="height" constant="160" id="pH0-fX-ZTo"/>
                                                        </constraints>
                                                        <string key="text">Research has shown an important association between alcohol consumption and breast cancer—for each 10 grams of alcohol consumed (less than 1 standard drink) on an average daily basis, a woman’s chance of developing postmenopausal breast cancer increases by around 9 percent. </string>
                                                        <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                                        <nil key="textColor"/>
                                                        <nil key="highlightedColor"/>
                                                    </label>
                                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="•" textAlignment="natural" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="1vl-It-iCq" userLabel="bullet3" customClass="FontLL15" customModule="CalmscientIOS" customModuleProvider="target">
                                                        <rect key="frame" x="20" y="399" width="15" height="20.333333333333314"/>
                                                        <constraints>
                                                            <constraint firstAttribute="width" constant="15" id="zej-Od-JFe"/>
                                                        </constraints>
                                                        <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                                        <nil key="textColor"/>
                                                        <nil key="highlightedColor"/>
                                                    </label>
                                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="B4g-hn-woU" customClass="FontLL15" customModule="CalmscientIOS" customModuleProvider="target">
                                                        <rect key="frame" x="40" y="394" width="333" height="130"/>
                                                        <constraints>
                                                            <constraint firstAttribute="height" constant="130" id="igp-uK-SR9"/>
                                                        </constraints>
                                                        <string key="text">Research has also shown that alcohol misuse increases the risk of liver disease, cardiovascular  diseases, depression, and stomach bleeding, as well as cancers of the oral cavity, esophagus, larynx, pharynx, liver, colon, and rectum. </string>
                                                        <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                                        <nil key="textColor"/>
                                                        <nil key="highlightedColor"/>
                                                    </label>
                                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="•" textAlignment="natural" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="0tG-c6-W9Q" userLabel="bullet4" customClass="FontLL15" customModule="CalmscientIOS" customModuleProvider="target">
                                                        <rect key="frame" x="20" y="528" width="15" height="20.333333333333371"/>
                                                        <constraints>
                                                            <constraint firstAttribute="width" constant="15" id="TeL-XS-3J8"/>
                                                        </constraints>
                                                        <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                                        <nil key="textColor"/>
                                                        <nil key="highlightedColor"/>
                                                    </label>
                                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="Oqd-Yf-OJe" customClass="FontLL15" customModule="CalmscientIOS" customModuleProvider="target">
                                                        <rect key="frame" x="40" y="524" width="333" height="90"/>
                                                        <constraints>
                                                            <constraint firstAttribute="height" constant="90" id="Fen-FH-ZhC"/>
                                                        </constraints>
                                                        <string key="text">People who misuse alcohol may also have problems managing conditions such as diabetes, high blood pressure, pain, and sleep disorders.</string>
                                                        <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                                        <nil key="textColor"/>
                                                        <nil key="highlightedColor"/>
                                                    </label>
                                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="•" textAlignment="natural" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="uBz-gc-B5m" userLabel="bullet5" customClass="FontLL15" customModule="CalmscientIOS" customModuleProvider="target">
                                                        <rect key="frame" x="20" y="619" width="15" height="20.333333333333371"/>
                                                        <constraints>
                                                            <constraint firstAttribute="width" constant="15" id="MKU-wq-c7A"/>
                                                        </constraints>
                                                        <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                                        <nil key="textColor"/>
                                                        <nil key="highlightedColor"/>
                                                    </label>
                                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="gXJ-Rs-KRf" customClass="FontLL15" customModule="CalmscientIOS" customModuleProvider="target">
                                                        <rect key="frame" x="40" y="614" width="333" height="110"/>
                                                        <constraints>
                                                            <constraint firstAttribute="height" constant="110" id="Co7-y7-49a"/>
                                                        </constraints>
                                                        <string key="text">And people who misuse alcohol are more likely to engage in unsafe sexual behavior, putting themselves and others at risk for sexually transmitted infections and unintentional pregnancies.</string>
                                                        <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                                        <nil key="textColor"/>
                                                        <nil key="highlightedColor"/>
                                                    </label>
                                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="•" textAlignment="natural" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="h0P-jA-aNo" userLabel="bullet6" customClass="FontLL15" customModule="CalmscientIOS" customModuleProvider="target">
                                                        <rect key="frame" x="20" y="731" width="15" height="20.333333333333371"/>
                                                        <constraints>
                                                            <constraint firstAttribute="width" constant="15" id="hmZ-X9-7DV"/>
                                                        </constraints>
                                                        <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                                        <nil key="textColor"/>
                                                        <nil key="highlightedColor"/>
                                                    </label>
                                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="e5K-t6-sko" customClass="FontLL15" customModule="CalmscientIOS" customModuleProvider="target">
                                                        <rect key="frame" x="40" y="729" width="333" height="200"/>
                                                        <constraints>
                                                            <constraint firstAttribute="height" constant="200" id="e0Z-1e-ST4"/>
                                                        </constraints>
                                                        <string key="text">Birth defects. Prenatal alcohol exposure can result in brain damage and other serious problems in babies. The effects are known as fetal alcohol spectrum disorders, or FASD, and can result in lifelong physical, cognitive, and behavioral problems. Because there is no known safe level of alcohol for a developing baby, women who are pregnant or might be pregnant should not drink.</string>
                                                        <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                                        <nil key="textColor"/>
                                                        <nil key="highlightedColor"/>
                                                    </label>
                                                    <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="cwo-30-SDY" customClass="CapsuleButton1" customModule="CalmscientIOS" customModuleProvider="target">
                                                        <rect key="frame" x="306" y="949" width="67" height="40"/>
                                                        <constraints>
                                                            <constraint firstAttribute="height" constant="40" id="wtR-jG-y0L"/>
                                                        </constraints>
