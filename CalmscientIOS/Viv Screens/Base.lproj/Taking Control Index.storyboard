            <objects>
                <viewController storyboardIdentifier="Modarate4VC" id="qXy-Jy-dyg" customClass="Modarate4VC" customModule="CalmscientIOS" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="sku-ia-yAW">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Problematic drinking" textAlignment="natural" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="XHf-QN-Eio" customClass="FontLM16" customModule="CalmscientIOS" customModuleProvider="target">
                                <rect key="frame" x="20" y="79" width="353" height="20"/>
                                <constraints>
                                    <constraint firstAttribute="height" constant="20" id="PMN-qp-S1v"/>
                                </constraints>
                                <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                <color key="textColor" red="0.42745098040000001" green="0.41960784309999999" blue="0.68235294120000001" alpha="1" colorSpace="custom" customColorSpace="displayP3"/>
                                <nil key="highlightedColor"/>
                            </label>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="GE4-d8-TZV" customClass="FontLL15" customModule="CalmscientIOS" customModuleProvider="target">
                                <rect key="frame" x="20" y="119" width="353" height="100"/>
                                <constraints>
                                    <constraint firstAttribute="height" constant="100" id="Jmw-5F-d4j"/>
                                </constraints>
                                <string key="text">I’m proud of you for recognizing the need to address your heavy drinking! Acknowledging that your drinking patterns may be problematic is a crucial first step toward a healthier life.</string>
                                <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                <nil key="textColor"/>
                                <nil key="highlightedColor"/>
                            </label>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="Grl-Tz-eeK" customClass="FontLL15" customModule="CalmscientIOS" customModuleProvider="target">
                                <rect key="frame" x="20" y="239" width="353" height="120"/>
                                <constraints>
                                    <constraint firstAttribute="height" constant="120" id="pfO-Zz-1y6"/>
                                </constraints>
                                <string key="text">It's essential to reflect on how your alcohol consumption impacts your well-being and relationships. By committing to change and taking small steps to reduce your drinking, you can begin to experience the benefits of a more balanced lifestyle.</string>
                                <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                <nil key="textColor"/>
                                <nil key="highlightedColor"/>
                            </label>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Label" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="XLJ-dh-SZG" customClass="FontLL15" customModule="CalmscientIOS" customModuleProvider="target">
