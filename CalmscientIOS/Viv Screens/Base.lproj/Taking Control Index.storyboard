                                                <rect key="frame" x="0.0" y="0.0" width="393" height="960"/>
                                                <subviews>
                                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="“I’m ready to quit”" textAlignment="natural" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="qUC-T1-qYB" customClass="FontLM16" customModule="CalmscientIOS" customModuleProvider="target">
                                                        <rect key="frame" x="20" y="20" width="353" height="20"/>
