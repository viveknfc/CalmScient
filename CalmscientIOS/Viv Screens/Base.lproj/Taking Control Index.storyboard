                                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Nicotine cravings" textAlignment="natural" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="Lrj-VK-ABb" customClass="FontLM16" customModule="CalmscientIOS" customModuleProvider="target">
                                                        <rect key="frame" x="10" y="55" width="333" height="20"/>
                                                        <constraints>
                                                            <constraint firstAttribute="height" constant="20" id="A23-Xx-Vb8"/>
                                                        </constraints>
                                                        <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                                        <color key="textColor" red="0.42882183190000001" green="0.41974490879999998" blue="0.68238306049999997" alpha="1" colorSpace="custom" customColorSpace="displayP3"/>
                                                        <nil key="highlightedColor"/>
                                                    </label>
                                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" textAlignment="natural" lineBreakMode="wordWrap" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="3sA-7r-1R4" customClass="FontLL15" customModule="CalmscientIOS" customModuleProvider="target">
                                                        <rect key="frame" x="15" y="95" width="323" height="200"/>
                                                        <constraints>
                                                            <constraint firstAttribute="height" constant="200" id="2jj-eu-Oi8"/>
                                                        </constraints>
                                                        <string key="text">When you're trying to quit smoking, pretty much everyone feels the urge to smoke from time to time. It can be a small feeling or sometimes really strong. But guess what?

Dealing with these cravings is a big deal for staying smoke-free.

Here are some ways to handle it:</string>
                                                        <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                                        <nil key="textColor"/>
                                                        <nil key="highlightedColor"/>
                                                    </label>
                                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Use quit-smoking medicines" textAlignment="natural" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="K85-OT-l8V" customClass="FontLM16" customModule="CalmscientIOS" customModuleProvider="target">
                                                        <rect key="frame" x="10" y="305" width="333" height="20"/>
                                                        <constraints>
                                                            <constraint firstAttribute="height" constant="20" id="Gn5-FH-k7v"/>
                                                        </constraints>
                                                        <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                                        <color key="textColor" name="6E6BB3ColorOnly"/>
                                                        <nil key="highlightedColor"/>
                                                    </label>
                                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="tpv-Na-YZh" customClass="FontLL15" customModule="CalmscientIOS" customModuleProvider="target">
                                                        <rect key="frame" x="10" y="335" width="333" height="80"/>
                                                        <constraints>
                                                            <constraint firstAttribute="height" constant="80" id="knf-PI-090"/>
                                                        </constraints>
                                                        <string key="text">A nicotine patch plus a lozenge (mints/cough drops) or gum is the most common combination and you can get them at any drug store.</string>
                                                        <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                                        <nil key="textColor"/>
                                                        <nil key="highlightedColor"/>
                                                    </label>
                                                    <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="lB7-Q2-sNK" userLabel="view1">
                                                        <rect key="frame" x="35" y="435" width="308" height="120"/>
                                                        <subviews>
                                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="bJ2-VW-RVx" customClass="FontLL14" customModule="CalmscientIOS" customModuleProvider="target">
                                                                <rect key="frame" x="5" y="5" width="298" height="110"/>
                                                                <string key="text">Put on a new patch each morning to get a steady level of nicotine that will reduce your cravings and withdrawal symptoms throughout the day.</string>
                                                                <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                                                <nil key="textColor"/>
                                                                <nil key="highlightedColor"/>
                                                            </label>
                                                        </subviews>
                                                        <color key="backgroundColor" systemColor="systemBackgroundColor"/>
