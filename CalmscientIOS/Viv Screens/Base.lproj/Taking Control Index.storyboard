                                            <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="39x-fs-E2g" customClass="RoundedView" customModule="CalmscientIOS" customModuleProvider="target">
                                                <rect key="frame" x="0.0" y="0.0" width="353" height="1815"/>
                                                <subviews>
                                                    <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="taz-T7-sTx">
                                                        <rect key="frame" x="308" y="20" width="25" height="25"/>
