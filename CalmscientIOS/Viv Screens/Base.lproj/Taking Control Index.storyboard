        <scene sceneID="z1Z-8h-6yW">
            <objects>
                <viewController storyboardIdentifier="Modarate3VC" id="PrY-ep-9H4" customClass="Modarate3VC" customModule="CalmscientIOS" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="V2D-fc-ng4">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Social / weekend binge drinking" textAlignment="natural" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="e07-B4-4gB" customClass="FontLM16" customModule="CalmscientIOS" customModuleProvider="target">
                                <rect key="frame" x="20" y="79" width="353" height="20"/>
                                <constraints>
                                    <constraint firstAttribute="height" constant="20" id="eZI-Cq-G1l"/>
                                </constraints>
                                <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                <color key="textColor" red="0.42745098040000001" green="0.41960784309999999" blue="0.68235294120000001" alpha="1" colorSpace="custom" customColorSpace="displayP3"/>
                                <nil key="highlightedColor"/>
                            </label>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="Uyh-Li-P94" customClass="FontLL15" customModule="CalmscientIOS" customModuleProvider="target">
                                <rect key="frame" x="20" y="119" width="353" height="80"/>
                                <constraints>
                                    <constraint firstAttribute="height" constant="80" id="Q5T-xp-Xzw"/>
                                </constraints>
                                <string key="text">I’m proud of you for recognizing the need to control your drinking pattern! Acknowledging your drinking patterns is a crucial first step toward healthier habits.</string>
                                <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                <nil key="textColor"/>
                                <nil key="highlightedColor"/>
                            </label>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="LAu-rm-KDv" customClass="FontLL15" customModule="CalmscientIOS" customModuleProvider="target">
                                <rect key="frame" x="20" y="219" width="353" height="140"/>
                                <constraints>
                                    <constraint firstAttribute="height" constant="140" id="oAu-1g-Khe"/>
                                </constraints>
                                <string key="text">It's important to reflect on your drinking habits, especially during social events, and consider how you can enjoy those moments without going overboard. By taking small steps to reduce your consumption, you’ll start to see the benefits for both your health and your relationships.</string>
                                <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                <nil key="textColor"/>
                                <nil key="highlightedColor"/>
                            </label>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Label" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="h2C-Yi-vR2" customClass="FontLL15" customModule="CalmscientIOS" customModuleProvider="target">
