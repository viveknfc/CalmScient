        <!--Hold Your LiquorVC-->
        <scene sceneID="5oI-zi-CPB">
            <objects>
                <viewController storyboardIdentifier="HoldYourLiquorVC" id="g5f-4g-Dag" customClass="HoldYourLiquorVC" customModule="CalmscientIOS" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="FcW-SO-1mf">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <scrollView clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="2a4-m9-zUW">
                                <rect key="frame" x="0.0" y="59" width="393" height="793"/>
                                <subviews>
                                    <stackView opaque="NO" contentMode="scaleToFill" axis="vertical" translatesAutoresizingMaskIntoConstraints="NO" id="Kdm-SE-sZH">
                                        <rect key="frame" x="0.0" y="0.0" width="393" height="730"/>
                                        <subviews>
                                            <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="bYo-In-Ldb">
                                                <rect key="frame" x="0.0" y="0.0" width="393" height="730"/>
                                                <subviews>
                                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="UF0-VA-JpO" customClass="FontLM16" customModule="CalmscientIOS" customModuleProvider="target">
                                                        <rect key="frame" x="20" y="20" width="353" height="50"/>
                                                        <constraints>
                                                            <constraint firstAttribute="height" constant="50" id="DCT-qf-Yzh"/>
                                                        </constraints>
                                                        <string key="text">Why is being able to "hold your liquor" 
a concern?</string>
                                                        <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                                        <color key="textColor" red="0.42745098040000001" green="0.41960784309999999" blue="0.68235294120000001" alpha="1" colorSpace="custom" customColorSpace="displayP3"/>
                                                        <nil key="highlightedColor"/>
                                                    </label>
                                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="1sO-I9-zU1" customClass="FontLL15" customModule="CalmscientIOS" customModuleProvider="target">
                                                        <rect key="frame" x="20" y="90" width="353" height="140"/>
                                                        <constraints>
                                                            <constraint firstAttribute="height" constant="140" id="xKM-Vd-Mq7"/>
                                                        </constraints>
                                                        <string key="text">For some people who drink, it takes quite a few drinks to “get a buzz” or feel relaxed, and they may be less likely to show signs of intoxication compared to others. This is sometimes called being able to “hold your liquor” or “drink someone under the table.”</string>
                                                        <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                                        <nil key="textColor"/>
                                                        <nil key="highlightedColor"/>
                                                    </label>
                                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="TY6-eT-UO4" customClass="FontLL15" customModule="CalmscientIOS" customModuleProvider="target">
                                                        <rect key="frame" x="20" y="240" width="353" height="100"/>
                                                        <constraints>
                                                            <constraint firstAttribute="height" constant="100" id="EBm-H1-SMa"/>
                                                        </constraints>
                                                        <string key="text">Often these individuals are unaware that their body’s lower response to the intoxicating effects of alcohol isn’t protection from alcohol problems but instead is a reason for caution.
</string>
                                                        <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                                        <nil key="textColor"/>
                                                        <nil key="highlightedColor"/>
                                                    </label>
                                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="RxC-P7-fa6" customClass="FontLL15" customModule="CalmscientIOS" customModuleProvider="target">
                                                        <rect key="frame" x="20" y="350" width="353" height="280"/>
                                                        <constraints>
                                                            <constraint firstAttribute="height" constant="280" id="8cv-WV-Dlz"/>
                                                        </constraints>
                                                        <string key="text">These individuals tend to drink more, socialize with people who drink a lot, and develop a tolerance to alcohol (i.e., it takes more and more alcohol to feel or act intoxicated). As a result, they have an increased risk for developing AUD. Someone who misuses alcohol, especially over the long-term, can experience permanent liver, heart, or brain damage. And all people who drink, regardless of the amount, need to be aware that critical decision-making abilities and driving- related skills are already diminished long before a person shows physical signs of intoxication.
</string>
                                                        <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                                        <nil key="textColor"/>
                                                        <nil key="highlightedColor"/>
                                                    </label>
                                                    <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="ZPi-vP-cGF" customClass="CapsuleButton1" customModule="CalmscientIOS" customModuleProvider="target">
                                                        <rect key="frame" x="306" y="670" width="67" height="40"/>
                                                        <constraints>
                                                            <constraint firstAttribute="height" constant="40" id="9zb-Rh-y4m"/>
                                                        </constraints>
                                                        <inset key="imageEdgeInsets" minX="0.0" minY="0.0" maxX="2.2250738585072014e-308" maxY="0.0"/>
                                                        <state key="normal" title="Complete"/>
                                                        <connections>
                                                            <action selector="completeButtonPressed:" destination="g5f-4g-Dag" eventType="touchUpInside" id="4W8-Ep-KmV"/>
                                                        </connections>
                                                    </button>
                                                </subviews>
                                                <color key="backgroundColor" systemColor="systemBackgroundColor"/>
                                                <constraints>
                                                    <constraint firstItem="1sO-I9-zU1" firstAttribute="top" secondItem="UF0-VA-JpO" secondAttribute="bottom" constant="20" id="2fW-qs-VqG"/>
                                                    <constraint firstAttribute="bottom" secondItem="ZPi-vP-cGF" secondAttribute="bottom" constant="20" id="Fxm-iZ-u6Q"/>
