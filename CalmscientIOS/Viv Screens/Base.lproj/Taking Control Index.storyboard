        <!--Thinking Abt QuitingVC-->
        <scene sceneID="1qs-4o-e4U">
            <objects>
                <viewController storyboardIdentifier="ThinkingAbtQuitingVC" id="o9u-5k-Ehc" customClass="ThinkingAbtQuitingVC" customModule="CalmscientIOS" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="gZx-5b-Dai">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="“I’m thinking about quitting”" textAlignment="natural" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="0T3-T0-2Ph" customClass="FontLM16" customModule="CalmscientIOS" customModuleProvider="target">
                                <rect key="frame" x="20" y="79" width="353" height="20"/>
                                <constraints>
                                    <constraint firstAttribute="height" constant="20" id="zlT-q5-kDZ"/>
                                </constraints>
                                <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                <color key="textColor" red="0.42882183190000001" green="0.41974490879999998" blue="0.68238306049999997" alpha="1" colorSpace="custom" customColorSpace="displayP3"/>
                                <nil key="highlightedColor"/>
                            </label>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" textAlignment="natural" lineBreakMode="wordWrap" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="Ngd-6u-Bee" customClass="FontLL15" customModule="CalmscientIOS" customModuleProvider="target">
                                <rect key="frame" x="20" y="119" width="353" height="350"/>
                                <constraints>
                                    <constraint firstAttribute="height" constant="350" id="RCs-e0-ZBS"/>
                                </constraints>
                                <string key="text">Approximately 75% of smokers want to quit, but 25% are not interested. Perhaps you are thinking about it, but not quite ready to act. Although, cigarettes are expensive, you might still like the sensations of smoking. You may also feel pressured to quit because people smoke on the break or you live with someone who also smokes.

But just so you know, thinking about quitting is already a first big step forward toward change! It’s normal to feel intimidated by taking action. No one wants to fail.. But think about this.. If it’s going to be a challenge now and it’s going to be a challenge in 5 years, why not do it now without spending more money on cigarettes?</string>
                                <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                <nil key="textColor"/>
                                <nil key="highlightedColor"/>
                            </label>
                            <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" buttonType="system" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="jum-xd-DsJ" customClass="CapsuleButton1" customModule="CalmscientIOS" customModuleProvider="target">
