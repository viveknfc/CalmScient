                                <subviews>
                                    <stackView opaque="NO" contentMode="scaleToFill" axis="vertical" translatesAutoresizingMaskIntoConstraints="NO" id="IqH-Pd-MNX">
                                        <rect key="frame" x="0.0" y="0.0" width="353" height="815"/>
                                        <subviews>
                                            <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="l42-l2-usG" customClass="RoundedView" customModule="CalmscientIOS" customModuleProvider="target">
                                                <rect key="frame" x="0.0" y="0.0" width="353" height="815"/>
                                                <subviews>
                                                    <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="m8d-vw-YQh">
                                                        <rect key="frame" x="308" y="20" width="25" height="25"/>
                                                        <constraints>
                                                            <constraint firstAttribute="width" constant="25" id="BOK-Xx-IOi"/>
                                                            <constraint firstAttribute="height" constant="25" id="mcd-Oy-LtG"/>
                                                        </constraints>
                                                        <inset key="imageEdgeInsets" minX="0.0" minY="0.0" maxX="2.2250738585072014e-308" maxY="0.0"/>
                                                        <state key="normal" image="closeIcon"/>
                                                        <connections>
                                                            <action selector="closeButtonPresseed:" destination="tbW-uT-PRX" eventType="touchUpInside" id="fUH-sn-CYT"/>
                                                        </connections>
                                                    </button>
                                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Increased appetite and weight gain" textAlignment="natural" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="hPO-Hs-jhR" userLabel="Title 1" customClass="FontLM16" customModule="CalmscientIOS" customModuleProvider="target">
                                                        <rect key="frame" x="10" y="55" width="333" height="20"/>
                                                        <constraints>
                                                            <constraint firstAttribute="height" constant="20" id="coz-mD-Oqk"/>
                                                        </constraints>
                                                        <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                                        <color key="textColor" red="0.43137254899999999" green="0.41960784309999999" blue="0.70196078429999997" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                                        <nil key="highlightedColor"/>
                                                    </label>
                                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="of1-5R-Xg5" userLabel="subContext1" customClass="FontLL15" customModule="CalmscientIOS" customModuleProvider="target">
                                                        <rect key="frame" x="15" y="85" width="323" height="240"/>
                                                        <constraints>
                                                            <constraint firstAttribute="height" constant="240" id="1TQ-Th-rKB"/>
                                                        </constraints>
                                                        <string key="text">When you quit smoking, it's totally normal for your appetite to go up a bit. Your body might not burn calories as fast, and you might find yourself eating more, maybe because quitting can be a bit stressful, or you just want something to do with your hands and mouth. Plus, food might taste even better since your sense of smell and taste aren't dulled by smoke

Here's what you can do to manage it:</string>
                                                        <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                                        <nil key="textColor"/>
                                                        <nil key="highlightedColor"/>
                                                    </label>
                                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Smart snacking" textAlignment="natural" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="zCM-Ox-jZB" userLabel="Title 2" customClass="FontLM16" customModule="CalmscientIOS" customModuleProvider="target">
                                                        <rect key="frame" x="10" y="335" width="333" height="20"/>
                                                        <constraints>
                                                            <constraint firstAttribute="height" constant="20" id="5Au-oT-pud"/>
                                                        </constraints>
                                                        <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                                        <color key="textColor" red="0.43137254899999999" green="0.41960784309999999" blue="0.70196078429999997" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                                        <nil key="highlightedColor"/>
                                                    </label>
                                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="9LK-ZW-mOB" userLabel="subContext2" customClass="FontLL15" customModule="CalmscientIOS" customModuleProvider="target">
                                                        <rect key="frame" x="15" y="365" width="323" height="120"/>
                                                        <constraints>
                                                            <constraint firstAttribute="height" constant="120" id="oic-zv-41U"/>
                                                        </constraints>
                                                        <string key="text">Choose healthy snacks like celery, carrots, or sugar-free mints when you feel like munching between meals. You can also keep your hands and mouth busy with a toothpick or a straw.</string>
                                                        <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                                        <nil key="textColor"/>
                                                        <nil key="highlightedColor"/>
                                                    </label>
                                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Get moving" textAlignment="natural" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="r56-rx-8Ux" userLabel="Title 3" customClass="FontLM16" customModule="CalmscientIOS" customModuleProvider="target">
                                                        <rect key="frame" x="10" y="495" width="333" height="20"/>
                                                        <constraints>
                                                            <constraint firstAttribute="height" constant="20" id="FaJ-Ap-XV3"/>
                                                        </constraints>
                                                        <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                                        <color key="textColor" red="0.43137254899999999" green="0.41960784309999999" blue="0.70196078429999997" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                                        <nil key="highlightedColor"/>
                                                    </label>
                                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="You don't need to hit the gym, even a simple walk is great for your health." textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="Kbd-7G-f1b" userLabel="subContext3" customClass="FontLL15" customModule="CalmscientIOS" customModuleProvider="target">
                                                        <rect key="frame" x="15" y="525" width="323" height="60"/>
                                                        <constraints>
                                                            <constraint firstAttribute="height" constant="60" id="CXe-yK-pUl"/>
                                                        </constraints>
                                                        <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                                        <nil key="textColor"/>
                                                        <nil key="highlightedColor"/>
                                                    </label>
                                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Focus on eating" textAlignment="natural" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="tWm-XU-oV5" userLabel="Title 4" customClass="FontLM16" customModule="CalmscientIOS" customModuleProvider="target">
                                                        <rect key="frame" x="10" y="595" width="333" height="20"/>
                                                        <constraints>
                                                            <constraint firstAttribute="height" constant="20" id="sb0-OQ-29V"/>
                                                        </constraints>
                                                        <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                                        <color key="textColor" red="0.43137254899999999" green="0.41960784309999999" blue="0.70196078429999997" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                                        <nil key="highlightedColor"/>
                                                    </label>
                                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" textAlignment="natural" lineBreakMode="tailTruncation" numberOfLines="0" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="Ynu-z8-e6J" userLabel="subContext4" customClass="FontLL15" customModule="CalmscientIOS" customModuleProvider="target">
                                                        <rect key="frame" x="15" y="625" width="323" height="120"/>
                                                        <constraints>
                                                            <constraint firstAttribute="height" constant="120" id="KDz-JX-dTm"/>
                                                        </constraints>
                                                        <string key="text">When you eat, try to pay attention to what you're eating. Turn off the TV or put away your phone. Eating a bit slower and really savoring your food can help you notice when you're full.</string>
                                                        <fontDescription key="fontDescription" type="system" pointSize="17"/>
                                                        <nil key="textColor"/>
                                                        <nil key="highlightedColor"/>
                                                    </label>
