// Moderation (localized blocks)
"moderation_intro_text" = "2020〜2025年版の米国食事ガイドラインによると、ある特定の人はアルコールを摂取すべきではありません。次に当てはまる場合は、アルコールを完全に避けるのが最も安全です。\n\n";
"moderation_primary_reason_1" = "アルコールと相互作用する薬を服用している";
"moderation_primary_reason_2" = "飲酒で悪化する可能性のある持病を管理している";
"moderation_primary_reason_3" = "21歳未満（米国での法定飲酒年齢）";
"moderation_primary_reason_4" = "アルコール使用障害（AUD）から回復中、または飲酒量をコントロールできない";
"moderation_primary_reason_5" = "妊娠中、または妊娠の可能性がある";
"moderation_full_text" = "さらに、特に高齢者などで、車を運転する予定がある方や機械を操作する方、または技能・協調性・注意力を必要とする活動に参加する方は、アルコールを完全に避けるべきです。\n\nアルコールの乱用とは？\n\nNIAAA は「大量飲酒」を次のように定義しています。\n\n女性：\n1日に4杯以上、または週に8杯以上。\n\n男性：\n1日に5杯以上、または週に15杯以上。";
"moderation_target_women" = "1日に4杯以上、または週に8杯以上。";
"moderation_target_men" = "1日に5杯以上、または週に15杯以上。";

// Hold your liquor
"hold_your_liquor_header" = "なぜ「お酒に強い」ことが問題になるのでしょうか？";
"hold_your_liquor_body_paragraph_1" = "飲酒する人の中には、かなり多くの杯数を飲まないと「酔い」やリラックス感を得られず、他人と比べて酔いの兆候があまり出にくい人もいます。これは「お酒に強い」、あるいは「酒豪」と呼ばれることもあります。";
"hold_your_liquor_body_paragraph_2" = "こうした人は、体がアルコールの酔いの効果に対して反応しにくいことは、アルコールによる問題から身を守ることではなく、むしろ注意が必要な理由であることに、しばしば気づいていません。";
"hold_your_liquor_body_paragraph_3" = "こうした人は、より多く飲む傾向があり、多く飲む人々と付き合い、アルコールへの耐容性（つまり、酔ったりそうなふりをしたりするためにますます多くのアルコールが必要になること）を発達させます。その結果、AUDを発症するリスクが高まります。アルコールを乱用する人、特に長期にわたる場合、肝臓、心臓、または脳に永続的な損傷を受けることがあります。また、飲酒量に関わらず、すべての飲酒者は、身体的な酔いの兆候が現れるずっと前から、重要な意思決定能力や運転に関連する技能がすでに低下していることを認識する必要があります。";

// Tobacco (smoking basic knowledge)
"tobacco_header" = "タバコとは何ですか？";
"tobacco_body_paragraph_1" = "タバコはニコチアナ属の植物の葉から作られ、紙巻きタバコ、葉巻き、噛みタバコなどに使われます。タバコの主成分はニコチンで、これは自然由来の物質で、依存性があり、脳に影響を与えることがあります。";
"tobacco_body_paragraph_2" = "紙巻きタバコを吸うと、7,000種類以上の化学物質を吸入します。そのうちニコチンが喫煙を依存させる原因となります。また、煙の味を良くしたり、ニコチンがより吸収されやすくするために、他の化学物質も添加されています。";
"tobacco_body_paragraph_3" = "紙巻きタバコを1本吸うたびに、約1〜2ミリグラムのニコチンが摂取され、すぐに脳に届き、心拍が速くなり、血圧が上がり、呼吸が速くなります。一時的なエネルギー補給のようなものですが、習慣化することもあります。";
"tobacco_body_paragraph_4" = "紙巻きタバコは、定期的に喫煙する人が1日に約200回、脳にニコチンが届くように設計されています。噛みタバコなどの他のタバコ製品にもニコチンが含まれています。電子タバコを使って、タバコの煙に含まれる余分な化学物質なしにニコチンを摂取する人もいます。";
"tobacco_body_paragraph_5" = "ニコチンは脳に作用して気持ちよく感じさせ、快感を与えるため習慣化しやすくなります。そのため、タバコに何が含まれているのか、それが体と脳にどのような影響を与えるのかを理解することが重要です。";

// Vaping (smoking basic knowledge)
"vaping_header" = "ベイピング（電子タバコ）はタバコより安全なのですか？";
"vaping_body_paragraph_1" = "電子タバコには「e-cig」「ベイプ」「ベイプペン」など多くの名前があります。普通の紙巻きタバコのように見えるものから、USBメモリやペンのように見えるものまであります。";
"vaping_body_paragraph_2" = "これらのデバイスは電池で動作し、エアロゾルと呼ばれるものを吸入します。ベイピングは、通常の喫煙と比べて害が少ない選択肢かもしれないと考えられたため、人気になりました。";
"vaping_body_paragraph_3" = "そのエアロゾルには、通常ニコチン（必ずしも含まれるとは限りません）、フレーバー、その他の化学物質が含まれています。デバイスは充電式、使い捨て、タンクやモッド付きなどさまざまです。";
"vaping_body_paragraph_4" = "タバコより安全なのでしょうか？\n電子タバコのエアロゾルには、通常の紙巻きタバコの煙に含まれる7,000種類の化学物質の致命的な混合物よりも、有害な化学物質が少ない傾向があります。しかし、電子タバコのエアロゾルは無害ではありません。ニコチン、鉛などの重金属、揮発性有機化合物、発がん物質など、有害で潜在的に有害な物質を含むことがあります。";
"vaping_reference_url" = "https://www.cdc.gov/tobacco/basic_information/e-cigarettes/pdfs/Electronic-Cigarettes-Infographic-p.pdf";

// Smoking relax (smoking basic knowledge)
"smoking_relax_header" = "なぜ喫煙はリラックスできるように感じるのでしょうか？";
"smoking_relax_body_paragraph_1" = "ニコチンは脳に作用して、気持ちよく、目覚めた感じを与えます。ドーパミン、ノルエピネフリン、セロトニンなどの化学物質を放出し、「気持ちよさ」や「目覚め」の感覚をもたらします。ニコチンはまたエンドルフィンを素早く増加させ、リラックスしたり痛みを和らげたりするのに役立ちます。";
"smoking_relax_body_paragraph_2" = "そのため、大人も十代も、気分、感情、注意力を「リセット」するために喫煙を使う人がいます。不安や落ち込みに苦しむ人にとっては、気分を良くしようとする手段になることがあります。しかし、これらの感情に対処するには、より健康的な方法があることを知っておくことが重要です。";

// Smoking and mental health (smoking basic knowledge)
"smoking_mental_health_header" = "喫煙は精神的健康にどのように影響しますか？";
"smoking_mental_health_body_paragraph_1" = "多くの人は喫煙がストレスを和らげると思っています。しかし、ニコチンは脳で興味深い作用をします。ドーパミンという化学物質を放出し、幸福感のシグナルのように働き、気分を良くします。うつ病の人の中にはドーパミンが低い人もおり、すぐに気分を上げるために喫煙する場合があります。";
"smoking_mental_health_body_paragraph_2" = "しかし問題は…脳がニコチンの刺激に慣れると、十分なニコチンが得られないときにもっと喫煙を求めます。その結果、集中力が低下し、心拍数が速くなり、より不安でストレスを感じるようになります。";
"smoking_mental_health_body_paragraph_3" = "その結果、本当のストレスではなく、ニコチン不足によるストレスを減らすために喫煙することになります。これは不安や気分に影響する悪循環です。";
"smoking_mental_health_body_paragraph_4" = "たくさん喫煙すると、脳が自らドーパミンを作る機能を抑えてしまうため、うつ病はよく見られます。長期的には、脳内のドーパミンが減り、気分に影響します。";

// Make a plan - ChangeCell / DefineMakeCell
"make_plan_change_full_text" = "変化を考えていますか？\n\nアルコール／薬物の使用を減らすかどうかの決定は、あなた自身のものです。\n\nただし、推奨される飲酒ガイドラインを継続的に超えている場合は、飲酒をやめる、量を減らす、または控えることを検討するのが賢明です。\n複雑な気持ちになるのは自然なことです。\n\nそのメリットとデメリットについて考えたことはありますか？";
"make_plan_change_highlight_1" = "アルコール／薬物の使用を減らすかどうかの決定は、あなた自身のものです。";
"make_plan_change_highlight_2" = "飲酒をやめる、量を減らす、または控えることを検討するのが賢明です。";
"define_make_full_text" = "まずは、あなたにとって何が最善かを定義してみましょう。\n\n飲酒習慣を変えようと考えている場合、「減らす」か「やめる」かを決める必要があります。医療専門職、友人、または信頼できる人と選択肢について話し合うのは良い方法です。\n\nなお、長期間にわたり大量に飲酒していた人が急に飲酒をやめると、身体が痛みを伴う、あるいは命に関わる可能性のある離脱（禁断）症状の過程に入ることがあります。\n\n症状には、吐き気、心拍数の増加、けいれん、その他の問題が含まれることがあります。安全な回復計画のために医療の助けを求めてください。医師はこれらの症状に対処する薬を処方し、より安全で苦痛の少ない過程にすることができます。";
"define_make_highlight_1" = "命に関わる可能性のある離脱（禁断）症状の過程";
"define_make_highlight_2" = "吐き気、心拍数の増加、けいれん、その他の問題";
