// Moderation (localized blocks)
"moderation_intro_text" = "2020〜2025年版の米国食事ガイドラインによると、ある特定の人はアルコールを摂取すべきではありません。次に当てはまる場合は、アルコールを完全に避けるのが最も安全です。\n\n";
"moderation_primary_reason_1" = "アルコールと相互作用する薬を服用している";
"moderation_primary_reason_2" = "飲酒で悪化する可能性のある持病を管理している";
"moderation_primary_reason_3" = "21歳未満（米国での法定飲酒年齢）";
"moderation_primary_reason_4" = "アルコール使用障害（AUD）から回復中、または飲酒量をコントロールできない";
"moderation_primary_reason_5" = "妊娠中、または妊娠の可能性がある";
"moderation_full_text" = "さらに、特に高齢者などで、車を運転する予定がある方や機械を操作する方、または技能・協調性・注意力を必要とする活動に参加する方は、アルコールを完全に避けるべきです。\n\nアルコールの乱用とは？\n\nNIAAA は「大量飲酒」を次のように定義しています。\n\n女性：\n1日に4杯以上、または週に8杯以上。\n\n男性：\n1日に5杯以上、または週に15杯以上。";
"moderation_target_women" = "1日に4杯以上、または週に8杯以上。";
"moderation_target_men" = "1日に5杯以上、または週に15杯以上。";

// Make a plan - ChangeCell / DefineMakeCell
"make_plan_change_full_text" = "変化を考えていますか？\n\nアルコール／薬物の使用を減らすかどうかの決定は、あなた自身のものです。\n\nただし、推奨される飲酒ガイドラインを継続的に超えている場合は、飲酒をやめる、量を減らす、または控えることを検討するのが賢明です。\n複雑な気持ちになるのは自然なことです。\n\nそのメリットとデメリットについて考えたことはありますか？";
"make_plan_change_highlight_1" = "アルコール／薬物の使用を減らすかどうかの決定は、あなた自身のものです。";
"make_plan_change_highlight_2" = "飲酒をやめる、量を減らす、または控えることを検討するのが賢明です。";
"define_make_full_text" = "まずは、あなたにとって何が最善かを定義してみましょう。\n\n飲酒習慣を変えようと考えている場合、「減らす」か「やめる」かを決める必要があります。医療専門職、友人、または信頼できる人と選択肢について話し合うのは良い方法です。\n\nなお、長期間にわたり大量に飲酒していた人が急に飲酒をやめると、身体が痛みを伴う、あるいは命に関わる可能性のある離脱（禁断）症状の過程に入ることがあります。\n\n症状には、吐き気、心拍数の増加、けいれん、その他の問題が含まれることがあります。安全な回復計画のために医療の助けを求めてください。医師はこれらの症状に対処する薬を処方し、より安全で苦痛の少ない過程にすることができます。";
"define_make_highlight_1" = "命に関わる可能性のある離脱（禁断）症状の過程";
"define_make_highlight_2" = "吐き気、心拍数の増加、けいれん、その他の問題";
