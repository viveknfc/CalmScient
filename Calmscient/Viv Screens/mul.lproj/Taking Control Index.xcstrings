    },
    "fWT-vs-0uD.text" : {
      "comment" : "Class = \"UILabel\"; text = \"Why does smoking seem to relax me?\"; ObjectID = \"fWT-vs-0uD\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Why does smoking seem to relax me?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Por qué parece que fumar me relaja?\n"
          }
        }
      }
    },
    "g0v-XO-FLG.text" : {
      "comment" : "Class = \"UILabel\"; text = \"Try going to bed and waking up around the same time every day, even on weekends.\"; ObjectID = \"g0v-XO-FLG\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Try going to bed and waking up around the same time every day, even on weekends."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Intenta acostarte y despertarte a la misma hora todos los días, incluso los fines de semana.\n"
          }
        }
      }
    },
    "g2f-4A-RWO.text" : {
      "comment" : "Class = \"UILabel\"; text = \"Birth defects. Prenatal alcohol exposure can result in brain damage and other serious problems in babies. The effects are known as fetal alcohol spectrum disorders, or FASD, and can result in lifelong physical, cognitive, and behavioral problems. Because there is no known safe level of alcohol for a developing baby, women who are pregnant or might be pregnant should not drink.\"; ObjectID = \"g2f-4A-RWO\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Birth defects. Prenatal alcohol exposure can result in brain damage and other serious problems in babies. The effects are known as fetal alcohol spectrum disorders, or FASD, and can result in lifelong physical, cognitive, and behavioral problems. Because there is no known safe level of alcohol for a developing baby, women who are pregnant or might be pregnant should not drink."
          }
        }
      }
    },
    "G2g-L6-k7N.text" : {
      "comment" : "Class = \"UILabel\"; text = \"What are the U.S. guidelines for drinking?\"; ObjectID = \"G2g-L6-k7N\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "What are the U.S. guidelines for drinking?"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Cuáles son las pautas de EE. UU. para el consumo de alcohol?\n"
          }
        }
      }
    },
    "gAR-KU-Lqf.text" : {
      "comment" : "Class = \"UILabel\"; text = \"The CAGE questionnaire for smoking (modified from the familiar CAGE questionnaire for alcoholism), the \\\"four Cs\\\" test and the Fagerström Test for Nicotine Dependence help diagnose nicotine dependence based on standard criteria. Additional questions can  be used to determine a patient's readiness to change and the nature of reinforcement the patient receives  from smoking. These tools can assist family physicians in guiding patients to quit smoking-the single most important thing smokers can do to improve their health.\"; ObjectID = \"gAR-KU-Lqf\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "The CAGE questionnaire for smoking (modified from the familiar CAGE questionnaire for alcoholism), the \"four Cs\" test and the Fagerström Test for Nicotine Dependence help diagnose nicotine dependence based on standard criteria. Additional questions can  be used to determine a patient's readiness to change and the nature of reinforcement the patient receives  from smoking. These tools can assist family physicians in guiding patients to quit smoking-the single most important thing smokers can do to improve their health."
          }
        }
      }
    },
    "GE4-d8-TZV.text" : {
      "comment" : "Class = \"UILabel\"; text = \"I’m proud of you for recognizing the need to address your heavy drinking! Acknowledging that your drinking patterns may be problematic is a crucial first step toward a healthier life.\"; ObjectID = \"GE4-d8-TZV\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "I’m proud of you for recognizing the need to address your heavy drinking! Acknowledging that your drinking patterns may be problematic is a crucial first step toward a healthier life."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Estoy orgulloso de ti por reconocer la necesidad de trabajar en tu consumo excesivo de alcohol! Reconocer que tus patrones de consumo son un problema, es un paso crucial hacia una vida más saludable.\n"
          }
        }
      }
    },
    "gMh-rh-XzI.text" : {
      "comment" : "Class = \"UILabel\"; text = \"I’m proud of you setting a limit to alcohol consumption! You’re taking a really important first step by recognizing your daily reliance on alcohol, and that’s something to be proud of.\"; ObjectID = \"gMh-rh-XzI\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "I’m proud of you setting a limit to alcohol consumption! You’re taking a really important first step by recognizing your daily reliance on alcohol, and that’s something to be proud of."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Estoy orgulloso de que hayas establecido un límite para el consumo de alcohol! Estás dando un paso muy importante al reconocer tu dependencia diaria al alcohol, y eso es algo de lo que debes estar orgulloso.\n"
          }
        }
      }
    },
    "GQU-T4-53Y.text" : {
      "comment" : "Class = \"UILabel\"; text = \"Can start a week or more before you quit smoking.\"; ObjectID = \"GQU-T4-53Y\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Can start a week or more before you quit smoking."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes comenzar una semana o más antes de dejar de fumar.\n"
          }
        }
      }
    },
    "Grl-Tz-eeK.text" : {
      "comment" : "Class = \"UILabel\"; text = \"It's essential to reflect on how your alcohol consumption impacts your well-being and relationships. By committing to change and taking small steps to reduce your drinking, you can begin to experience the benefits of a more balanced lifestyle.\"; ObjectID = \"Grl-Tz-eeK\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "It's essential to reflect on how your alcohol consumption impacts your well-being and relationships. By committing to change and taking small steps to reduce your drinking, you can begin to experience the benefits of a more balanced lifestyle."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es fundamental reflexionar sobre cómo tu consumo de alcohol impacta tu bienestar y tus relaciones. Al comprometerte a cambiar y dar pequeños pasos para reducir tu consumo, podrás comenzar a experimentar los beneficios de un estilo de vida más equilibrado.\n"
          }
        }
      }
    },
    "grQ-rb-i1S.normalTitle" : {
      "comment" : "Class = \"UIButton\"; normalTitle = \"Complete\"; ObjectID = \"grQ-rb-i1S\";",
      "extractionState" : "extracted_with_value",
