    "hmL-VL-efn.text" : {
      "comment" : "Class = \"UILabel\"; text = \"Celebrate being tobacco-free for:\\n\\n•  3 days\\n•  7 days\\n•  2 weeks\\n•  1 month\\n•  3 months\\n•  6 months\\n•  1 year\"; ObjectID = \"hmL-VL-efn\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Celebrate being tobacco-free for:\n\n•  3 days\n•  7 days\n•  2 weeks\n•  1 month\n•  3 months\n•  6 months\n•  1 year"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Celebra estar libre de tabaco por:  • 3 días • 7 días • 2 semanas • 1 mes • 3 meses • 6 meses • 1 año\n"
          }
        }
      }
    },
