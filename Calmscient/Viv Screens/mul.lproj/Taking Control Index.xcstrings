    "TY6-eT-UO4.text" : {
      "comment" : "Class = \"UILabel\"; text = \"Often these individuals are unaware that their body’s lower response to the intoxicating effects of alcohol isn’t protection from alcohol problems but instead is a reason for caution.\\n\"; ObjectID = \"TY6-eT-UO4\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Often these individuals are unaware that their body’s lower response to the intoxicating effects of alcohol isn’t protection from alcohol problems but instead is a reason for caution.\n"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A menudo, estas personas no son conscientes de que la menor respuesta de su cuerpo al alcohol no es una protección contra los problemas sino una razón para tener aún más cuidado.\n"
          }
        }
      }
    },
