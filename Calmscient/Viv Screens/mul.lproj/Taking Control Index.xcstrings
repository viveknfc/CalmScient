    "tpv-Na-YZh.text" : {
      "comment" : "Class = \"UILabel\"; text = \"A nicotine patch plus a lozenge (mints/cough drops) or gum is the most common combination and you can get them at any drug store.\"; ObjectID = \"tpv-Na-YZh\";",
