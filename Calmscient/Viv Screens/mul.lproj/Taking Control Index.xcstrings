    "3sA-7r-1R4.text" : {
      "comment" : "Class = \"UILabel\"; text = \"When you're trying to quit smoking, pretty much everyone feels the urge to smoke from time to time. It can be a small feeling or sometimes really strong. But guess what?\\n\\nDealing with these cravings is a big deal for staying smoke-free.\\n\\nHere are some ways to handle it:\"; ObjectID = \"3sA-7r-1R4\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When you're trying to quit smoking, pretty much everyone feels the urge to smoke from time to time. It can be a small feeling or sometimes really strong. But guess what?\n\nDealing with these cravings is a big deal for staying smoke-free.\n\nHere are some ways to handle it:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando se intenta dejar de fumar, casi todos sienten el deseo de vez en cuando. Puede ser una sensación leve o a veces muy fuerte. Pero adivina qué…\n                                                                         Lidiar con estos deseos es un gran desafío para mantenerse libre.\n                                                                           Aquí tienes algunas formas de manejarlo:\n"
          }
        }
      }
    },
    "4Fx-r1-w6I.text" : {
      "comment" : "Class = \"UILabel\"; text = \"https://www.cdc.gov/tobacco/basic_information/e-cigarettes/pdfs/Electronic-Cigarettes-Infographic-p.pdf\"; ObjectID = \"4Fx-r1-w6I\";",
