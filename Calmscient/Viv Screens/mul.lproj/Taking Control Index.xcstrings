    "Oqd-Yf-OJe.text" : {
      "comment" : "Class = \"UILabel\"; text = \"People who misuse alcohol may also have problems managing conditions such as diabetes, high blood pressure, pain, and sleep disorders.\"; ObjectID = \"Oqd-Yf-OJe\";",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "People who misuse alcohol may also have problems managing conditions such as diabetes, high blood pressure, pain, and sleep disorders."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Las personas que hacen un uso indebido del alcohol también pueden tener problemas para manejar condiciones como diabetes, hipertensión, dolor y trastornos del sueño.\n"
          }
        }
      }
    },
