    "uxo-Hg-sa8.text" : {
      "comment" : "Class = \"UILabel\"; text = \"Half of liver disease deaths in the United States are caused by alcohol, and alcohol-associated liver disease is increasing, particularly among women and young people. \"; ObjectID = \"uxo-Hg-sa8\";",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Half of liver disease deaths in the United States are caused by alcohol, and alcohol-associated liver disease is increasing, particularly among women and young people. "
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• La mitad de las muertes por enfermedades hepáticas en los Estados Unidos son causadas por el alcohol.\n"
          }
        }
      }
    },
    "Uyh-Li-P94.text" : {
      "comment" : "Class = \"UILabel\"; text = \"I’m proud of you for recognizing the need to control your drinking pattern! Acknowledging your drinking patterns is a crucial first step toward healthier habits.\"; ObjectID = \"Uyh-Li-P94\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "I’m proud of you for recognizing the need to control your drinking pattern! Acknowledging your drinking patterns is a crucial first step toward healthier habits."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Estoy orgulloso de ti por reconocer la necesidad de controlar tu patrón de consumo de alcohol! Reconocer tus patrones de bebida es un paso crucial hacia hábitos más saludables.\n"
          }
        }
      }
    },
