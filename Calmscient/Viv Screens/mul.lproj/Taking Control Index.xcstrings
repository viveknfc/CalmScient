    "8FD-Vi-3D7.text" : {
      "comment" : "Class = \"UILabel\"; text = \"Doing some physical activity can really help with that jumpy feeling. Take a short walk or just get up and stretch if you're feeling restless.\"; ObjectID = \"8FD-Vi-3D7\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Doing some physical activity can really help with that jumpy feeling. Take a short walk or just get up and stretch if you're feeling restless."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hacer algo de actividad física puede realmente ayudar con esa sensación de nerviosismo. Da una corta caminata o simplemente levántate y estírate si te sientes inquieto.\n"
          }
        }
      }
    },
    "08h-TR-zeg.text" : {
      "comment" : "Class = \"UILabel\"; text = \"Take it easy\"; ObjectID = \"08h-TR-zeg\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Take it easy"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tómatelo con calma\n"
          }
        }
      }
    },
    "8kS-7r-b6Y.text" : {
      "comment" : "Class = \"UILabel\"; text = \"You're doing a fantastic job maintaining moderation with your drinking!    As you continue this healthy habit, remember to build other wellness practices like regular exercise, a balanced diet, and enough sleep.\"; ObjectID = \"8kS-7r-b6Y\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "You're doing a fantastic job maintaining moderation with your drinking!    As you continue this healthy habit, remember to build other wellness practices like regular exercise, a balanced diet, and enough sleep."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¡Estás haciendo un trabajo fantástico moderando tu consumo de alcohol!\nA medida que continúas con este hábito saludable, recuerda incorporar otras prácticas de bienestar, como el ejercicio regular, una dieta equilibrada y suficiente sueño.\n"
          }
        }
      }
    },
    "8m6-K3-z1k.text" : {
      "comment" : "Class = \"UILabel\"; text = \"If you're into coffee, tea, or other caffeinated drinks, avoid them in the late afternoon or evening. After quitting smoking, caffeine sticks around longer in your body.\"; ObjectID = \"8m6-K3-z1k\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If you're into coffee, tea, or other caffeinated drinks, avoid them in the late afternoon or evening. After quitting smoking, caffeine sticks around longer in your body."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si te gustan el café, el té u otras bebidas con cafeína, evítalos en la tarde o noche. Después de dejar de fumar, la cafeína permanece en tu cuerpo por más tiempo.\n"
          }
        }
      }
    },
