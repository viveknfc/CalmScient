    "kpp-nh-zEH.text" : {
      "comment" : "Class = \"UILabel\"; text = \"Right after you quit smoking, you might find it a bit tough to concentrate. Don't worry, it happens to a lot of people.\\n\\nHere's what you can do:\"; ObjectID = \"kpp-nh-zEH\";",
