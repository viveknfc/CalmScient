        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Piensa en por qué decidiste dejar de fumar. Es un gran motivador para superar los momentos de mal humor.\n"
          }
        }
      }
    },
    "Imf-Ss-LtA.normalTitle" : {
      "comment" : "Class = \"UIButton\"; normalTitle = \"Make a plan\"; ObjectID = \"Imf-Ss-LtA\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
