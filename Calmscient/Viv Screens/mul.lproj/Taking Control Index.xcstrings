    "1sO-I9-zU1.text" : {
      "comment" : "Class = \"UILabel\"; text = \"For some people who drink, it takes quite a few drinks to “get a buzz” or feel relaxed, and they may be less likely to show signs of intoxication compared to others. This is sometimes called being able to “hold your liquor” or “drink someone under the table.”\"; ObjectID = \"1sO-I9-zU1\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "For some people who drink, it takes quite a few drinks to “get a buzz” or feel relaxed, and they may be less likely to show signs of intoxication compared to others. This is sometimes called being able to “hold your liquor” or “drink someone under the table.”"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Para algunas personas que beben, se necesitan varias copas para \"sentirse bien\" o relajarse, y pueden ser menos propensas a mostrar signos de intoxicación en comparación con otras. Esto a veces se llama ser capaz de \"controlarse\" \n"
          }
        }
      }
    },
    "1vl-It-iCq.text" : {
