    "pkF-ZU-UHK.text" : {
      "comment" : "Class = \"UILabel\"; text = \"When you first quit smoking, it's totally normal to feel a bit jumpy or restless. It's like your body is adjusting without nicotine, and it can affect not just your mind but the rest of you too.\\n\\nHere's how you can handle it:\"; ObjectID = \"pkF-ZU-UHK\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When you first quit smoking, it's totally normal to feel a bit jumpy or restless. It's like your body is adjusting without nicotine, and it can affect not just your mind but the rest of you too.\n\nHere's how you can handle it:"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando dejas de fumar por primera vez, es totalmente normal sentirse un poco nervioso o inquieto. Es como si tu cuerpo se estuviera ajustando a la falta de nicotina, y esto puede afectar no solo tu mente, sino también el resto de tu cuerpo.  Aquí tienes cómo manejarlo:\n"
          }
        }
      }
    },
    "Ppw-ly-Pc4.text" : {
