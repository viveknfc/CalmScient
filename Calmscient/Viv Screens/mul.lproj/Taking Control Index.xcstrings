    "9LK-ZW-mOB.text" : {
      "comment" : "Class = \"UILabel\"; text = \"Choose healthy snacks like celery, carrots, or sugar-free mints when you feel like munching between meals. You can also keep your hands and mouth busy with a toothpick or a straw.\"; ObjectID = \"9LK-ZW-mOB\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Choose healthy snacks like celery, carrots, or sugar-free mints when you feel like munching between meals. You can also keep your hands and mouth busy with a toothpick or a straw."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elige bocadillos saludables como apio, zanahorias o mentas sin azúcar cuando sientas hambre entre comidas. También puedes mantener ocupadas tus manos y boca con un palillo o una pajilla.\n"
          }
        }
      }
    },
