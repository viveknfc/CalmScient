    "nvr-i7-mCn.text" : {
      "comment" : "Class = \"UILabel\"; text = \"If you're using the nicotine patch, try taking it off an hour before bedtime. Sometimes, nicotine from the patch can mess with your sleep.\"; ObjectID = \"nvr-i7-mCn\";",
