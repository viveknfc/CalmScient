    "Iij-Vm-hwB.text" : {
      "comment" : "Class = \"UILabel\"; text = \"Think about why you decided to quit. It's a great motivator to push through the grumpy moments.\"; ObjectID = \"Iij-Vm-hwB\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
