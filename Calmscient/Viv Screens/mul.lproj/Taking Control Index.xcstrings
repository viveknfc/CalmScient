    "LzV-Am-45f.text" : {
      "comment" : "Class = \"UILabel\"; text = \"Do you enjoy a drink now or then? Many of us do, often when socializing with friends and family. Let's take a look at your drinking patterns and how they may affect your health.\\n\\nThe AUDIT questionnaire is designed to help in the self-assessment of alcohol consumption and to identify any implications for the person's health and well being, now and in the future.\\n\\nConduct a quick self-test with AUDIT above. Click on \\\"Submit\\\" at the end for an instant assessment.\"; ObjectID = \"LzV-Am-45f\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Do you enjoy a drink now or then? Many of us do, often when socializing with friends and family. Let's take a look at your drinking patterns and how they may affect your health.\n\nThe AUDIT questionnaire is designed to help in the self-assessment of alcohol consumption and to identify any implications for the person's health and well being, now and in the future.\n\nConduct a quick self-test with AUDIT above. Click on \"Submit\" at the end for an instant assessment."
          }
        }
      }
    },
    "mdG-bt-k5b.text" : {
