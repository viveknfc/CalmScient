    "2tZ-ww-axx.text" : {
      "comment" : "Class = \"UILabel\"; text = \"If you're into coffee, tea, or other caffeinated drinks, try cutting back a bit. After quitting smoking, caffeine hangs around in your body longer.\\n\\nIncrease your chance to success\"; ObjectID = \"2tZ-ww-axx\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "If you're into coffee, tea, or other caffeinated drinks, try cutting back a bit. After quitting smoking, caffeine hangs around in your body longer.\n\nIncrease your chance to success"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Si te gustan el café, el té u otras bebidas con cafeína, trata de reducirlas un poco. Después de dejar de fumar, la cafeína permanece en tu cuerpo por más tiempo.\n                                                                                Aumenta tus posibilidades de éxito\n"
          }
        }
      }
    },
