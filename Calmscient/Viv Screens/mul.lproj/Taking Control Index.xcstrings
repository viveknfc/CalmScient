    "la1-dn-BSn.text" : {
      "comment" : "Class = \"UILabel\"; text = \"When your quit day arrives, get rid of all your cigarettes and/or chewing tobacco.\"; ObjectID = \"la1-dn-BSn\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
