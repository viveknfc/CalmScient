    "vA9-EV-zbU.text" : {
      "comment" : "Class = \"UILabel\"; text = \"Mood swings and anxiety; alcohol is a “depressant” that leads to mood swings, irritability, and increased risk of developing depression and anxiety.\"; ObjectID = \"vA9-EV-zbU\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
