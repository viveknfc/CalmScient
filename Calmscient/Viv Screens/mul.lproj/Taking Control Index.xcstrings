            "value" : "Finalizar"
          }
        }
      }
    },
    "gSr-WK-JbT.text" : {
      "comment" : "Class = \"UILabel\"; text = \"Research has shown an important association between alcohol consumption and breast cancer—for each 10 grams of alcohol consumed (less than 1 standard drink) on an average daily basis, a woman’s chance of developing postmenopausal breast cancer increases by around 9 percent. \"; ObjectID = \"gSr-WK-JbT\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Research has shown an important association between alcohol consumption and breast cancer—for each 10 grams of alcohol consumed (less than 1 standard drink) on an average daily basis, a woman’s chance of developing postmenopausal breast cancer increases by around 9 percent. "
          }
        }
      }
    },
    "gWS-tl-5JN.text" : {
      "comment" : "Class = \"UILabel\"; text = \"Be kind to yourself\"; ObjectID = \"gWS-tl-5JN\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Be kind to yourself"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sé amable contigo mismo\n"
          }
        }
      }
    },
    "gXJ-Rs-KRf.text" : {
      "comment" : "Class = \"UILabel\"; text = \"And people who misuse alcohol are more likely to engage in unsafe sexual behavior, putting themselves and others at risk for sexually transmitted infections and unintentional pregnancies.\"; ObjectID = \"gXJ-Rs-KRf\";",
      "extractionState" : "stale",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "And people who misuse alcohol are more likely to engage in unsafe sexual behavior, putting themselves and others at risk for sexually transmitted infections and unintentional pregnancies."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "• Y las personas que abusan del alcohol tienen más probabilidades de participar en comportamientos sexuales no seguros, poniéndose a sí mismas y a otras personas en riesgo de infecciones de transmisión sexual y embarazos no deseados.\n"
          }
        }
      }
    },
