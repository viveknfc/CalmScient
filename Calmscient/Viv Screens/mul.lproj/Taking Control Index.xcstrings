      }
    },
    "Lug-SK-tCh.text" : {
      "comment" : "Class = \"UILabel\"; text = \"Exercise can really boost your mood. Start with something small and work your way up. It might be tough when you're feeling low, but it's worth it!\"; ObjectID = \"Lug-SK-tCh\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Exercise can really boost your mood. Start with something small and work your way up. It might be tough when you're feeling low, but it's worth it!"
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El ejercicio puede realmente mejorar tu estado de ánimo. Comienza con algo pequeño y ve aumentando. Puede ser difícil cuando te sientes decaído, ¡pero vale la pena!\n"
          }
        }
      }
    },
