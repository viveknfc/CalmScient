      }
    },
    "WOV-qb-aW9.text" : {
      "comment" : "Class = \"UILabel\"; text = \"And people who misuse alcohol are more likely to engage in unsafe sexual behavior, putting themselves and others at risk for sexually transmitted infections and unintentional pregnancies.\"; ObjectID = \"WOV-qb-aW9\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "And people who misuse alcohol are more likely to engage in unsafe sexual behavior, putting themselves and others at risk for sexually transmitted infections and unintentional pregnancies."
          }
        }
      }
    },
    "WTS-sK-lmi.text" : {
      "comment" : "Class = \"UILabel\"; text = \"No TV, phones, or gadgets in bed. Make your bedroom quiet, dark, relaxing, and comfy.\\nSkip heavy meals or alcohol right before bedtime.\"; ObjectID = \"WTS-sK-lmi\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "No TV, phones, or gadgets in bed. Make your bedroom quiet, dark, relaxing, and comfy.\nSkip heavy meals or alcohol right before bedtime."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nada de TV, teléfonos o gadgets en la cama. Haz que tu dormitorio sea tranquilo, oscuro, relajante y cómodo. Evita comidas pesadas o alcohol justo antes de acostarte.\n"
          }
        }
      }
    },
