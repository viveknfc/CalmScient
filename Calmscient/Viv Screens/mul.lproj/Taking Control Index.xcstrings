      }
    },
    "Ynu-z8-e6J.text" : {
      "comment" : "Class = \"UILabel\"; text = \"When you eat, try to pay attention to what you're eating. Turn off the TV or put away your phone. Eating a bit slower and really savoring your food can help you notice when you're full.\"; ObjectID = \"Ynu-z8-e6J\";",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "When you eat, try to pay attention to what you're eating. Turn off the TV or put away your phone. Eating a bit slower and really savoring your food can help you notice when you're full."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cuando comas, trata de prestar atención a lo que estás comiendo. Apaga la televisión o guarda tu teléfono. Comer un poco más despacio y realmente saborear tu comida puede ayudarte a notar cuando estás lleno.\n"
          }
        }
      }
    },
