// Challenging to quit journey (Swift UI)
"challenging_to_quit_header" = "¿Por qué es difícil dejar de fumar?";
"challenging_to_quit_body_paragraph_1" = "La mayoría de los adolescentes que fuman piensan que dejarán en sus 20 y en realidad no lo hacen hasta sus 40. Dejar de fumar implica hacer un cambio, y no somos muy buenos en eso; de hecho, dejar de fumar puede ser un largo viaje de intentos y recaídas, como un largo paseo en montaña rusa. No hay una solución mágica ni un medicamento que convierta a alguien en no fumador de la noche a la mañana, aunque algunas personas tienen el gen para poder dejar de fumar o beber sin grandes dificultades.";
"challenging_to_quit_body_paragraph_2" = "¿Cómo se ve este viaje de cambio? Hay 4 pasos y estrategias útiles que puedes tomar.";
"challenging_to_quit_topic_thinking" = "\"Estoy pensando en dejarlo\"";
"challenging_to_quit_topic_ready" = "\"Preparándome para dejar de fumar\"";
"challenging_to_quit_topic_quitting" = "\"Dejando de fumar\"";
"challenging_to_quit_topic_smoke_free" = "\"Mantenerme libre de humo\"";
"thinking_about_quitting_header" = "\"Estoy pensando en dejarlo\"";
"thinking_about_quitting_body_paragraph_1" = "Aproximadamente el 75 % de los fumadores quiere dejar de fumar, pero el 25 % no está interesado. Tal vez lo estés pensando, pero aún no estés listo para actuar. Aunque los cigarrillos son caros, quizá aún te gusten las sensaciones de fumar. También puedes sentir presión para dejar de fumar porque la gente fuma en el descanso o vives con alguien que también fuma.";
"thinking_about_quitting_body_paragraph_2" = "Pero debes saber que pensar en dejar de fumar ya es un gran primer paso hacia el cambio. Es normal sentirse intimidado al tomar acción. Nadie quiere fracasar. Pero piensa en esto: si va a ser un desafío ahora y va a ser un desafío en 5 años, ¿por qué no hacerlo ahora sin gastar más dinero en cigarrillos?";
"ready_to_quit_header" = "\"Estoy listo para dejar de fumar\"";
"ready_to_quit_body_paragraph_1" = "Si alguna vez intentaste dejar de fumar en el pasado, tienes una idea de cómo se siente, los desafíos que experimentaste y qué te hizo volver a fumar. Eso significa que ya has probado este camino y sabes lo complicado que puede ser. Hay pequeños pasos que puedes dar ahora para ayudarte a dejar de fumar para siempre y aumentar tus posibilidades de éxito. Aprende las habilidades que te ayudarán a lograr permanentemente una vida libre de tabaco.";
"ready_to_quit_body_paragraph_2" = "En las siguientes secciones, puedes aprender estrategias recomendadas para superar los posibles desafíos que puedas encontrar.";
"trying_to_quit_header" = "\"Estoy intentando dejar de fumar\"";
"trying_to_quit_body_paragraph_1" = "Has llegado a tu fecha para dejar de fumar y te has comprometido a una vida libre de tabaco.";
"trying_to_quit_body_paragraph_2" = "¡Siéntete orgulloso! Dejar de fumar es como una ruptura y pasar por algunas pérdidas. Puede que tengas que cambiar un poco tu rutina para evitar ciertos lugares, amigos, y empezar una nueva rutina para distraerte. El plan requiere que pienses en más que solo dejar de fumar, sino en cambios en tu estilo de vida.";
"trying_to_quit_body_paragraph_3" = "Hay algunas claves para lograr una vida permanentemente libre de tabaco.";
"trying_to_quit_body_paragraph_4" = "¿Qué puedes hacer?";
"trying_to_quit_habits_heading" = "¿Qué nuevos hábitos te ayudan a seguir adelante?";
"trying_to_quit_habit_bullet_1" = "Haz algo para mantenerte activo en casa";
"trying_to_quit_habit_bullet_2" = "Llama o visita a un amigo o familiar";
"trying_to_quit_habit_bullet_3" = "Cepíllate los dientes";
"trying_to_quit_habit_bullet_4" = "Juega con una mascota";
"trying_to_quit_habit_bullet_5" = "Actualiza tu lista de contactos en tu teléfono móvil";
"trying_to_quit_habit_bullet_6" = "Prueba un nuevo pasatiempo";
"trying_to_quit_habit_bullet_7" = "Cambia a café con menos cafeína o productos descafeinados";
"trying_to_quit_rewards_heading" = "¿Cuánto dinero has ahorrado al dejar el tabaco? ¿Cómo te estás recompensando?";
"trying_to_quit_celebrate_heading" = "Celebra estar libre de tabaco durante:";
"trying_to_quit_milestone_3_days" = "3 días";
