//moderation
"When is drinking in moderation still too much?" = "¿Cuándo es beber con moderación todavía demasiado?";

// Moderation (localized blocks)
"moderation_intro_text" = "Según las Guías Alimentarias para Estadounidenses 2020-2025, ciertas personas no deben consumir alcohol. Es más seguro evitar el alcohol por completo si:\n\n";
"moderation_primary_reason_1" = "Tomar medicamentos que interactúan con el alcohol";
"moderation_primary_reason_2" = "Manejar una condición médica que puede empeorar con el consumo de alcohol";
"moderation_primary_reason_3" = "Menor de 21 años, la edad mínima legal para beber en los Estados Unidos";
"moderation_primary_reason_4" = "Recuperándose de un trastorno por consumo de alcohol (AUD) o incapaz de controlar la cantidad que bebes";
"moderation_primary_reason_5" = "Embarazada o podría estar embarazada";
"moderation_full_text" = "Además, ciertas personas, especialmente los adultos mayores, que planean conducir un vehículo o operar maquinaria—o que están participando en actividades que requieren destreza, coordinación y alerta—deben evitar el alcohol por completo.\n\n¿Qué es el abuso de alcohol?\n\nEl NIAAA define el consumo excesivo de alcohol de la siguiente manera:\n\nPara mujeres:\n4 o más bebidas en un día o 8 o más por semana.\n\nPara hombres:\n5 o más bebidas en un día o 15 o más por semana.";
"moderation_target_women" = "4 o más bebidas en un día o 8 o más por semana.";
"moderation_target_men" = "5 o más bebidas en un día o 15 o más por semana.";

// Hold your liquor
"hold_your_liquor_header" = "¿Por qué es una preocupación poder “retener el licor”?";
"hold_your_liquor_body_paragraph_1" = "Para algunas personas que beben, se necesitan bastantes tragos para “sentirse bien” o relajarse, y es menos probable que muestren signos de intoxicación en comparación con otros. A esto a veces se le llama poder “retener el licor” o “beberle a alguien debajo de la mesa”.";
"hold_your_liquor_body_paragraph_2" = "A menudo, estas personas no son conscientes de que la menor respuesta de su cuerpo a los efectos intoxicantes del alcohol no es una protección contra los problemas del alcohol, sino que es un motivo de precaución.";
"hold_your_liquor_body_paragraph_3" = "Estas personas tienden a beber más, socializar con personas que beben mucho y desarrollar tolerancia al alcohol (es decir, se necesita cada vez más alcohol para sentirse o actuar intoxicado). Como resultado, tienen un mayor riesgo de desarrollar AUD. Alguien que hace un uso indebido del alcohol, especialmente a largo plazo, puede experimentar daños permanentes en el hígado, el corazón o el cerebro. Y todas las personas que beben, independientemente de la cantidad, deben ser conscientes de que las habilidades críticas para tomar decisiones y las habilidades relacionadas con la conducción ya están disminuidas mucho antes de que una persona muestre signos físicos de intoxicación.";

// Tobacco (smoking basic knowledge)
"tobacco_header" = "¿Qué es el tabaco?";
"tobacco_body_paragraph_1" = "El tabaco proviene de las hojas de la planta Nicotiana y se utiliza en cosas como cigarrillos, puros y tabaco de mascar. Lo principal en el tabaco es la nicotina, una sustancia natural que puede ser adictiva y afectar tu cerebro.";
"tobacco_body_paragraph_2" = "Cuando las personas fuman cigarrillos, inhalan más de 7,000 químicos, y la nicotina es la que hace que fumar sea adictivo. También se añaden otros químicos para que el humo tenga mejor sabor y para que la nicotina se absorba más fácilmente.";
"tobacco_body_paragraph_3" = "Cada vez que alguien fuma un cigarrillo, recibe aproximadamente 1-2 miligramos de nicotina, que llega rápidamente a su cerebro y hace que su corazón lata más rápido, aumenta su presión arterial y acelera su respiración. Es como un impulso rápido de energía, pero puede convertirse en un hábito.";
"tobacco_body_paragraph_4" = "Los cigarrillos están diseñados para que alguien que fuma regularmente reciba alrededor de 200 \"dosis\" de nicotina en su cerebro cada día. Otros productos de tabaco, como el tabaco de mascar, también contienen nicotina. Algunas personas usan cigarrillos electrónicos para obtener nicotina sin todos los químicos adicionales en el humo del tabaco.";
"tobacco_body_paragraph_5" = "La nicotina actúa en el cerebro de manera que te hace sentir bien y puede convertirse en un hábito porque brinda una sensación de placer. Por eso es importante entender qué contiene el tabaco y qué efectos puede tener en tu cuerpo y cerebro.";

// Vaping (smoking basic knowledge)
"vaping_header" = "¿Cómo es que vapear (cigarrillos electrónicos) es más seguro que fumar tabaco?";
"vaping_body_paragraph_1" = "Los cigarrillos electrónicos tienen muchos nombres, como \"e-cigs,\" \"vapes\" o \"lapiceros de vapeo.\" Pueden parecer cigarrillos normales o incluso parecer otras cosas como USBs o lapiceros.";
"vaping_body_paragraph_2" = "Estos dispositivos funcionan con baterías y permiten a las personas inhalar algo llamado aerosol. El vapeo se hizo popular porque algunos pensaron que podría ser una opción menos dañina en comparación con fumar cigarrillos normales.";
"vaping_body_paragraph_3" = "Dentro de ese aerosol, generalmente hay nicotina (aunque no siempre), sabores y algunos otros químicos. Los dispositivos pueden ser recargables, desechables o venir con tanques de recarga.";
"vaping_body_paragraph_4" = "¿Es más seguro que el tabaco?\nEl aerosol de los cigarrillos electrónicos generalmente contiene menos químicos tóxicos que la mortal mezcla de 7,000 químicos en el humo de los cigarrillos normales. Sin embargo, el aerosol de los cigarrillos electrónicos no es inofensivo. Puede contener sustancias nocivas y potencialmente dañinas, incluyendo nicotina, metales pesados como el plomo, compuestos orgánicos volátiles y agentes cancerígenos.";
"vaping_reference_url" = "https://www.cdc.gov/tobacco/basic_information/e-cigarettes/pdfs/Electronic-Cigarettes-Infographic-p.pdf";

// Smoking relax (smoking basic knowledge)
"smoking_relax_header" = "¿Por qué parece que fumar me relaja?";
"smoking_relax_body_paragraph_1" = "La nicotina hace cosas en tu cerebro que te hacen sentir bien y más despierto. Libera químicos como la dopamina, norepinefrina y serotonina, que son los responsables de esas sensaciones de \"sentirse bien\" y \"estar despierto\". La nicotina también te da un rápido impulso de endorfinas, lo que puede ayudarte a relajarte y aliviar cualquier dolor.";
"smoking_relax_body_paragraph_2" = "Por eso algunas personas, tanto adultos como adolescentes, fuman para \"reiniciar\" su estado de ánimo, emociones y atención. Especialmente para aquellos que luchan con la ansiedad y depresión, fumar podría ser una manera en la que intentan sentirse mejor. Pero es importante saber que hay formas más saludables de lidiar con estos sentimientos.";

// Smoking and mental health (smoking basic knowledge)
"smoking_mental_health_header" = "¿Cómo es que fumar afecta tu salud mental?";
"smoking_mental_health_body_paragraph_1" = "Muchas personas creen que fumar alivia el estrés. Sin embargo, la nicotina hace algo interesante en tu cerebro: libera una sustancia química llamada dopamina. La dopamina es como una señal de felicidad y te hace sentir bien. Algunas personas con depresión tienen niveles bajos de dopamina, por lo que podrían fumar para obtener un impulso rápido.";
"smoking_mental_health_body_paragraph_2" = "Pero aquí está el problema… una vez que tu cerebro se acostumbra a los estímulos de la nicotina, pedirá más cigarrillos cuando no reciba suficiente nicotina. Así, tu concentración disminuye, el corazón late más rápido, y te sientes más ansioso y estresado.";
"smoking_mental_health_body_paragraph_3" = "Como resultado, fumas para reducir el estrés causado por la falta de nicotina, no tu estrés real. Este es un círculo vicioso que afecta tu ansiedad y estado de ánimo.";
"smoking_mental_health_body_paragraph_4" = "La depresión es común porque, cuando fumas mucho, tu cerebro prácticamente apaga su propia manera de producir dopamina. A largo plazo, tu cerebro produce menos dopamina, lo cual afecta tu estado de ánimo.";

// Make a plan - ChangeCell / DefineMakeCell
"make_plan_change_full_text" = "¿Pensando en un cambio?\n\n¡Queremos que sepas que la decisión de reducir el consumo de alcohol/drogas es completamente tuya!\n\nPero si te encuentras superando constantemente las pautas recomendadas para el consumo de alcohol, sería prudente considerar detener, reducir o disminuir tu consumo.\nEs normal tener sentimientos encontrados.\n\n¿Has pensado en los pros y contras de hacerlo?";
"make_plan_change_highlight_1" = "la decisión de reducir el consumo de alcohol/drogas es completamente tuya!";
"make_plan_change_highlight_2" = "detener, reducir o disminuir tu consumo.";
"define_make_full_text" = "En primer lugar, definamos qué es lo mejor para ti.\n\nSi estás considerando cambiar tu forma de beber, tendrás que decidir si reducir o dejar de beber. Es una buena idea hablar sobre las diferentes opciones con un profesional de la salud, un amigo o alguien en quien confíes.\n\nTen en cuenta que, cuando una persona que ha estado bebiendo en exceso durante un período prolongado deja de beber repentinamente, su cuerpo puede entrar en un proceso de abstinencia doloroso o incluso potencialmente mortal.\n\nLos síntomas pueden incluir náuseas, ritmo cardíaco acelerado, convulsiones u otros problemas. Busca ayuda médica para planificar una recuperación segura. Los médicos pueden recetar medicamentos para tratar estos síntomas y hacer que el proceso sea más seguro y menos angustiante.";
"define_make_highlight_1" = "un proceso de abstinencia doloroso o incluso potencialmente mortal.";
"define_make_highlight_2" = "náuseas, ritmo cardíaco acelerado, convulsiones u otros problemas.";

